@page "/products"
@rendermode InteractiveServer
@using AspireApp_Productos.Web.Models
@using System.Net.Http.Json
@using AspireApp_Productos.Web.Components
@inject IHttpClientFactory HttpFactory

<h3>Productos</h3>

<div class="mb-3">
    <button type="button" class="btn btn-primary me-2" @onclick="Refresh">Actualizar</button>
    <button type="button" class="btn btn-success me-2" @onclick="ShowAdd">Agregar</button>
    <button type="button" class="btn btn-danger" @onclick="DeleteSelected" disabled=@(SelectedId == null)>Eliminar</button>
</div>

<ProductsAddModal @ref="addModal" OnSaved="OnProductSaved" />

@if (products == null)
{
    <p>Cargando...</p>
}
else if (!products.Any())
{
    <p>No hay productos.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Creado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in products)
            {
                <tr class="@GetRowClass(p.Id)" style="cursor:pointer;" @onclick="() => Select(p.Id)">
                    <td>@p.Id</td>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td>@p.Price</td>
                    <td>@p.CreatedAt.ToLocalTime()</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<Product>? products;
    int? SelectedId;
    Product newProduct = new();
    ProductsAddModal? addModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    HttpClient Client => HttpFactory.CreateClient("Api");

    async Task LoadProducts()
    {
        products = await Client.GetFromJsonAsync<List<Product>>("api/products");
        SelectedId = null;
        StateHasChanged();
    }

    Task Refresh() => LoadProducts();

    async Task ShowAdd()
    {
        if (addModal != null)
        {
            await addModal.Show();
        }
    }

    async Task OnProductSaved(Product p)
    {
        var res = await Client.PostAsJsonAsync("api/products", p);
        if (res.IsSuccessStatusCode)
        {
            await LoadProducts();
        }
        else
        {
            // manejar error sencillo
        }
    }

    async Task DeleteSelected()
    {
        if (SelectedId == null)
            return;

        var res = await Client.DeleteAsync($"api/products/{SelectedId}");
        if (res.IsSuccessStatusCode || res.StatusCode == System.Net.HttpStatusCode.NoContent)
        {
            await LoadProducts();
        }
    }

    async Task Select(int id)
    {
        SelectedId = id;
        await InvokeAsync(StateHasChanged);
    }

    string GetRowClass(int id) => SelectedId == id ? "table-active" : string.Empty;
}
